<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Worms Zone.io - Landscape Main Menu</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Fredoka for cartoon game aesthetic -->
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&display=swap" rel="stylesheet">
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
            -webkit-touch-callout: none;
        }

        html, body {
            width: 100vw;
            height: 100vh;
            height: 100dvh;
            margin: 0;
            padding: 0;
            overflow: hidden;
            position: fixed;
            top: 0;
            left: 0;
            font-family: 'Fredoka', sans-serif;
            background-color: #16468a;
            background-image: 
                radial-gradient(circle at 15% 20%, rgba(255, 255, 255, 0.12) 0%, transparent 40%),
                radial-gradient(circle at 85% 80%, rgba(0, 0, 0, 0.3) 0%, transparent 50%),
                radial-gradient(circle at 50% 50%, #1f5cb8 0%, #11356a 100%);
            touch-action: none;
        }

        .game-bg-texture {
            background-image: radial-gradient(rgba(255, 255, 255, 0.18) 1.5px, transparent 1.5px);
            background-size: 24px 24px;
        }

        /* Glossy Button Styles */
        .btn-green-glossy {
            background: linear-gradient(to bottom, #7be231 0%, #46b811 50%, #308a09 100%);
            border: 3px solid #c2ff6b;
            box-shadow: 0 4px 0 #1e5c04, 0 6px 12px rgba(0,0,0,0.4);
            transition: all 0.08s ease;
        }
        .btn-green-glossy:active {
            transform: translateY(2px);
            box-shadow: 0 2px 0 #1e5c04, 0 3px 6px rgba(0,0,0,0.4);
        }

        .btn-blue-glossy {
            background: linear-gradient(to bottom, #4fc3f7 0%, #0288d1 50%, #01579b 100%);
            border: 2px solid #b3e5fc;
            box-shadow: 0 3px 0 #003366, 0 4px 10px rgba(0,0,0,0.3);
            transition: all 0.08s ease;
        }
        .btn-blue-glossy:active {
            transform: translateY(2px);
            box-shadow: 0 1px 0 #003366, 0 2px 5px rgba(0,0,0,0.3);
        }

        .btn-panel {
            background: rgba(0, 0, 0, 0.35);
            backdrop-filter: blur(6px);
            border: 2px solid rgba(255, 255, 255, 0.25);
            box-shadow: inset 0 2px 4px rgba(255,255,255,0.1), 0 3px 8px rgba(0,0,0,0.3);
        }

        /* Text 3D stroke effects */
        .text-outline-dark {
            text-shadow: 
                -2px -2px 0 #000,  
                 2px -2px 0 #000,
                -2px  2px 0 #000,
                 2px  2px 0 #000,
                 0px  3px 6px rgba(0,0,0,0.6);
        }

        .logo-worms {
            background: linear-gradient(to bottom, #ffee55 0%, #ff9800 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 3px 0px #803300);
        }

        .logo-zone {
            background: linear-gradient(to bottom, #81d4fa 0%, #0288d1 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 3px 0px #01579b);
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-5px) rotate(1deg); }
        }
        .animate-float {
            animation: float 2.8s ease-in-out infinite;
        }

        @keyframes pulse-glow {
            0%, 100% { filter: drop-shadow(0 0 8px rgba(123, 226, 49, 0.7)); }
            50% { filter: drop-shadow(0 0 18px rgba(123, 226, 49, 1)); }
        }
        .battle-glow {
            animation: pulse-glow 2s infinite;
        }

        @media screen and (orientation: portrait) {
            #orientation-warning {
                display: flex !important;
            }
        }
    </style>
</head>
<body class="game-bg-texture w-screen h-screen flex flex-col justify-between p-2 md:p-3 overflow-hidden">

    <div id="orientation-warning" class="fixed inset-0 bg-[#0d2d5e]/95 z-50 flex-col items-center justify-center p-6 text-center hidden">
        <div class="w-16 h-16 bg-amber-400 rounded-2xl border-4 border-white flex items-center justify-center text-2xl mb-3 shadow-2xl animate-bounce">
            📱🔄
        </div>
        <h2 class="text-xl font-extrabold text-amber-300 text-outline-dark mb-1">Please Rotate Your Device!</h2>
        <p class="text-white text-xs max-w-xs font-medium mb-3">
            Worms Zone.io is optimized for Landscape mode. Turn your phone sideways!
        </p>
        <button onclick="dismissOrientationWarning()" class="btn-green-glossy px-5 py-2 rounded-xl text-white font-extrabold text-xs uppercase">
            Continue Anyway
        </button>
    </div>

    <header class="w-full flex justify-between items-center z-10 shrink-0">
        
        <!-- Top Left: Player Profile Card -->
        <div class="flex items-center bg-[#0d2d5e]/85 border-2 border-white/25 rounded-xl p-1.5 pr-3 shadow-lg backdrop-blur-md">
            <!-- Avatar container -->
            <div class="relative bg-gradient-to-b from-amber-300 to-amber-500 w-10 h-10 rounded-lg flex items-center justify-center border-2 border-white shadow-inner">
                <span class="text-xl">😱</span>
                <!-- Level Badge -->
                <div class="absolute -bottom-1 -right-1 bg-amber-500 text-white text-[10px] font-bold px-1.5 py-0.2 rounded-full border border-white shadow">
                    1
                </div>
            </div>
            <!-- Name & Level Bar -->
            <div class="ml-2.5 flex flex-col justify-center">
                <span class="text-white font-bold text-xs tracking-wide drop-shadow">hanmakun106</span>
                <!-- Level progress bar -->
                <div class="w-24 bg-black/50 h-2.5 rounded-full p-0.5 border border-white/30 mt-0.5 relative overflow-hidden">
                    <div class="bg-gradient-to-r from-amber-500 to-yellow-300 h-full rounded-full w-2/3 shadow"></div>
                </div>
            </div>
        </div>

        <!-- Top Right: Resources & Event Promo Icons -->
        <div class="flex items-center space-x-2">
            
            <!-- Promo Item 1: Dragon Skin -->
            <div onclick="openModal('Special Event', 'Dragon Festival event is active! Complete missions to earn exclusive legendary worm skins.')" class="relative cursor-pointer transform hover:scale-105 transition">
                <div class="w-10 h-10 bg-gradient-to-br from-red-500 to-amber-600 rounded-xl border-2 border-yellow-300 flex items-center justify-center shadow-md">
                    <i class="fa-solid fa-dragon text-white text-base drop-shadow"></i>
                </div>
                <div class="absolute -bottom-2 left-1/2 transform -translate-x-1/2 bg-black/85 text-yellow-300 text-[8px] font-bold px-1.5 py-0.1 rounded-full border border-yellow-300 whitespace-nowrap shadow">
                    3d 1h
                </div>
            </div>

            <!-- Promo Item 2: Piggy Bank -->
            <div onclick="openModal('Piggy Bank', 'Your Piggy Bank is collecting coins as you play! Break it open to claim your savings.')" class="relative cursor-pointer transform hover:scale-105 transition">
                <div class="w-10 h-10 bg-gradient-to-br from-pink-400 to-rose-600 rounded-xl border-2 border-white flex items-center justify-center shadow-md">
                    <i class="fa-solid fa-piggy-bank text-white text-base drop-shadow"></i>
                </div>
                <div class="absolute -bottom-2 left-1/2 transform -translate-x-1/2 bg-black/85 text-white text-[8px] font-bold px-1.5 py-0.1 rounded-full border border-white/50 whitespace-nowrap shadow">
                    23h 54m
                </div>
            </div>

            <!-- Resource Counter: Apples -->
            <div class="flex items-center bg-[#0d2d5e]/90 border-2 border-white/25 rounded-xl px-2 py-1 shadow-md">
                <span class="text-lg mr-1">🍎</span>
                <span class="text-white font-bold text-xs mr-1.5">20/20</span>
                <button onclick="openModal('Apples Refilled', 'Your apple energy is completely full! Jump into battle to feed your worm.')" class="bg-gradient-to-b from-blue-400 to-blue-600 text-white w-5 h-5 rounded-md flex items-center justify-center border border-white/60 shadow font-bold text-xs">
                    +
                </button>
            </div>

            <!-- Resource Counter: Coins -->
            <div class="flex items-center bg-[#0d2d5e]/90 border-2 border-white/25 rounded-xl px-2 py-1 shadow-md">
                <span class="text-lg mr-1">🪙</span>
                <span class="text-white font-bold text-xs mr-1.5">1</span>
                <button onclick="openModal('Gold Shop', 'Need more gold coins? Spin the lucky wheel or purchase coin packs in the store!')" class="bg-gradient-to-b from-blue-400 to-blue-600 text-white w-5 h-5 rounded-md flex items-center justify-center border border-white/60 shadow font-bold text-xs">
                    +
                </button>
            </div>

        </div>
    </header>

    <main class="w-full flex-1 flex flex-row items-center justify-between px-2 my-auto relative z-0">
        
        <!-- Left Section: Central Gift Box -->
        <div class="flex flex-col items-center justify-center animate-float w-1/4">
            <div onclick="openGiftBox()" class="cursor-pointer relative group">
                <!-- Gift Box Graphic -->
                <div class="w-20 h-20 md:w-24 md:h-24 bg-gradient-to-b from-red-500 to-red-700 rounded-2xl border-3 border-yellow-300 shadow-xl flex items-center justify-center relative transform group-hover:scale-105 transition">
                    <!-- Vertical Yellow Ribbon -->
                    <div class="absolute w-4 h-full bg-gradient-to-r from-yellow-300 to-amber-400 border-x border-amber-500"></div>
                    <!-- Horizontal Yellow Ribbon -->
                    <div class="absolute h-4 w-full bg-gradient-to-b from-yellow-300 to-amber-400 border-y border-amber-500"></div>
                    <!-- Bow on top -->
                    <div class="absolute -top-3.5 flex items-center justify-center">
                        <div class="w-6 h-4 bg-yellow-300 rounded-full border-2 border-amber-600 -mr-2 transform -rotate-45 shadow"></div>
                        <div class="w-4 h-4 bg-amber-400 rounded-full border-2 border-amber-600 z-10 shadow"></div>
                        <div class="w-6 h-4 bg-yellow-300 rounded-full border-2 border-amber-600 -ml-2 transform rotate-45 shadow"></div>
                    </div>
                    <!-- Sparkle icon -->
                    <i class="fa-solid fa-sparkles text-yellow-200 text-xl z-20 animate-pulse"></i>
                </div>
            </div>
            <!-- Open Button Pill -->
            <button onclick="openGiftBox()" class="mt-2 bg-gradient-to-b from-amber-300 to-amber-500 hover:from-amber-200 hover:to-amber-400 text-amber-950 font-extrabold px-4 py-0.5 rounded-full border-2 border-white shadow-md text-xs tracking-wide transform hover:scale-105 transition">
                Open
            </button>
        </div>

        <!-- Center Section: Worms Zone Logo & Battle Action -->
        <div class="flex flex-col items-center justify-center text-center w-2/4">
            
            <!-- Game Logo with Cute Worm -->
            <div class="relative flex items-center justify-center mb-1">
                <div class="absolute -top-5 z-10 animate-float flex flex-col items-center">
                    <div class="w-7 h-7 bg-red-500 rounded-full border-2 border-white flex items-center justify-center relative shadow-md">
                        <span class="text-sm">👀</span>
                        <!-- Mushroom hat top -->
                        <div class="absolute -top-2 w-5 h-3 bg-white rounded-t-full border border-red-500"></div>
                        <div class="absolute -top-2 w-1.5 h-1.5 bg-red-500 rounded-full"></div>
                    </div>
                </div>
                <div>
                    <h1 class="logo-worms text-3xl md:text-5xl font-extrabold tracking-wider uppercase text-outline-dark m-0 leading-none">
                        WORMS
                    </h1>
                    <h2 class="logo-zone text-2xl md:text-4xl font-extrabold tracking-widest uppercase text-outline-dark -mt-1">
                        ZONE
                    </h2>
                </div>
            </div>

            <!-- Main Action: To Battle! Button -->
            <div class="w-full max-w-[280px]">
                <button onclick="startBattle()" class="btn-green-glossy battle-glow w-full py-2.5 rounded-2xl text-white font-extrabold text-xl md:text-2xl tracking-wider uppercase text-outline-dark transform hover:scale-105 transition">
                    To battle!
                </button>
                
                <!-- Workshop Button & Subtext -->
                <div class="mt-1.5 flex flex-col items-center w-full">
                    <button onclick="openWorkshop()" class="btn-blue-glossy px-6 py-1.5 rounded-xl text-white font-bold text-sm tracking-wide uppercase shadow-md transform hover:scale-105 transition">
                        Workshop
                    </button>
                    <span class="text-white/85 text-[11px] font-semibold mt-0.5 drop-shadow">
                        Choose the skin for your worm
                    </span>
                </div>
            </div>

        </div>

        <!-- Right Spacer for Balance -->
        <div class="w-1/4 hidden md:flex"></div>

    </main>

    <footer class="w-full flex justify-between items-center z-10 shrink-0">
        
        <!-- Bottom Left Dock Buttons -->
        <div class="flex items-center space-x-2.5">
            <!-- Leaderboard Podium Button -->
            <button onclick="openLeaderboard()" class="btn-panel w-10 h-10 rounded-xl flex items-center justify-center text-white text-lg hover:bg-white/20 transition shadow-md">
                <i class="fa-solid fa-ranking-star text-amber-300"></i>
            </button>

            <!-- Chat Bubble Button with 250 Badge -->
            <button onclick="openChat()" class="relative btn-panel w-10 h-10 rounded-xl flex items-center justify-center text-white text-lg hover:bg-white/20 transition shadow-md">
                <i class="fa-solid fa-comments text-blue-300"></i>
                <!-- Badge -->
                <div class="absolute -top-1.5 -right-1.5 bg-gradient-to-r from-amber-400 to-yellow-500 text-amber-950 font-extrabold text-[9px] px-1 py-0.1 rounded-full border-2 border-white shadow">
                    250
                </div>
            </button>
        </div>

        <!-- Bottom Right Dock Buttons -->
        <div class="flex items-center space-x-2.5">
            <!-- Share Button -->
            <button onclick="shareGame()" class="btn-panel w-10 h-10 rounded-xl flex items-center justify-center text-white text-lg hover:bg-white/20 transition shadow-md">
                <i class="fa-solid fa-share-nodes text-sky-300"></i>
            </button>

            <!-- Settings Gear Button -->
            <button onclick="openSettings()" class="btn-panel w-10 h-10 rounded-xl flex items-center justify-center text-white text-lg hover:bg-white/20 transition shadow-md">
                <i class="fa-solid fa-gear text-slate-300"></i>
            </button>
        </div>

    </footer>

    <div id="gameModal" class="fixed inset-0 bg-black/75 backdrop-blur-sm z-50 flex items-center justify-center p-3 hidden">
        <div class="bg-gradient-to-b from-[#1f5cb8] to-[#11356a] border-3 border-amber-300 rounded-2xl max-w-xs w-full p-4 text-center shadow-2xl relative transform transition-all scale-95 opacity-0" id="modalContainer">
            <!-- Close button -->
            <button onclick="closeModal()" class="absolute top-2.5 right-2.5 bg-red-600 hover:bg-red-500 text-white w-7 h-7 rounded-full font-bold text-sm border-2 border-white flex items-center justify-center shadow">
                <i class="fa-solid fa-xmark"></i>
            </button>
            
            <!-- Modal Title -->
            <h3 id="modalTitle" class="text-xl font-extrabold text-amber-300 text-outline-dark mb-1.5">Notice</h3>
            
            <!-- Modal Content -->
            <p id="modalBody" class="text-white text-xs md:text-sm mb-4 font-medium leading-relaxed">
                Modal description goes here.
            </p>
            
            <!-- Modal Action Button -->
            <button onclick="closeModal()" class="btn-green-glossy px-6 py-2 rounded-xl text-white font-extrabold text-sm uppercase tracking-wide">
                Awesome!
            </button>
        </div>
    </div>

    <script>
        function dismissOrientationWarning() {
            document.getElementById('orientation-warning').style.display = 'none';
        }

        function openModal(title, message) {
            const modal = document.getElementById('gameModal');
            const container = document.getElementById('modalContainer');
            document.getElementById('modalTitle').innerText = title;
            document.getElementById('modalBody').innerText = message;
            
            modal.classList.remove('hidden');
            setTimeout(() => {
                container.classList.remove('scale-95', 'opacity-0');
                container.classList.add('scale-100', 'opacity-100');
            }, 10);
        }

        function closeModal() {
            const modal = document.getElementById('gameModal');
            const container = document.getElementById('modalContainer');
            
            container.classList.remove('scale-100', 'opacity-100');
            container.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 150);
        }

        function startBattle() {
            openModal('Entering Battle!', 'Matchmaking in progress... Prepare your worm, eat delicious food, and conquer the landscape arena!');
        }

        function openWorkshop() {
            openModal('Worm Workshop', 'Choose from amazing skins, colors, hats, and patterns to customize your worm before battle!');
        }

        function openGiftBox() {
            openModal('🎁 Gift Box Opened!', 'Congratulations! You received 50 Gold Coins and a Rare Mystery Skin piece!');
        }

        function openLeaderboard() {
            openModal('🏆 Leaderboard', 'Global Top Players:\n1. WormKing99 - 1,450,200 pts\n2. SlitherPro - 980,450 pts\n3. hanmakun106 - 12,400 pts (You)');
        }

        function openChat() {
            openModal('💬 Worms Community Chat', 'You have 250 unread clan messages. Join the discussion and share your high scores!');
        }

        function shareGame() {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(window.location.href).catch(() => {});
            }
            openModal('Link Copied!', 'Game invite link copied to clipboard. Share it with your friends!');
        }

        function openSettings() {
            openModal('⚙️ Settings', 'Sound Effects: ON\nMusic: ON\nGraphics: High\nControls: Landscape Touch\nVersion: v2.4.1');
        }
    </
